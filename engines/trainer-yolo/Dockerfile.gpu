# syntax=docker/dockerfile:1
# Engine trainer-yolo GPU (ADR-0010 D5): treino real com ultralytics.
# Base: hephaestus/engine-base-gpu (PyTorch 2.6.0 + CUDA 12.4 + cuDNN 9 + libs apt + USER studio uid 1000).
ARG BASE_GPU_IMAGE=hephaestus/engine-base-gpu:0.1.0
FROM ${BASE_GPU_IMAGE}

# Ultralytics 8.3.x — última versão estável da linha 8.3 (8.3.253, Sep 2026).
# Pin exato para reprodutibilidade; ADR-0010 D5. Cache mount para pip.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install "ultralytics==8.3.253" "openai-clip"

WORKDIR /app

# Copy engine_kit e trainer_yolo package
COPY engines/engine-kit/src/engine_kit/ /app/engine_kit/
COPY engines/trainer-yolo/src/trainer_yolo/ /app/trainer_yolo/

# Real training mode (not mock)
ENV ENGINE_MOCK=0

RUN chown -R studio:studio /app
USER studio

# Bake yolo11n.pt base weight into the image layer (~5MB).
# Sem dependência de rede no runtime para o modelo default.
RUN python -c "from ultralytics import YOLO; YOLO('yolo11n.pt')"

ENTRYPOINT ["python", "-m", "trainer_yolo"]
CMD ["train", "--config", "/dev/null", "--output", "/dev/null"]
