{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.19.0/.schema/devbox.schema.json",
  "packages": {
    "nodejs@22.23.4": {},
    "rustup@1.29.2": {},
    "python@3.12.15": {
      "disable_plugin": true
    },
    "uv@0.13.5": {},
    "bun@1.3.13": {},
    "cmake@3.31.7": {},
    "gcc@15.3.0": {},
    "perl@5.42.3": {},
    "pkg-config@0.29.2": {},
    "docker-compose@5.6.0": {}
  },
  "env": {
    "RUSTUP_HOME": "$DEVBOX_PROJECT_ROOT/.devbox/rustup",
    "CARGO_HOME": "$DEVBOX_PROJECT_ROOT/.devbox/cargo",
    "UV_PYTHON": "$DEVBOX_PACKAGES_DIR/bin/python3.12",
    "UV_PYTHON_DOWNLOADS": "never"
  },
  "shell": {
    "init_hook": [
      "export PATH=\"$CARGO_HOME/bin:$PATH\"",
      "unset RUSTUP_TOOLCHAIN",
      "(cd \"$DEVBOX_PROJECT_ROOT\" && { rustup which cargo-fmt >/dev/null 2>&1 && rustup which cargo-clippy >/dev/null 2>&1 || rustup toolchain install --no-self-update >&2; })"
    ],
    "scripts": {
      "setup": [
        "set -e",
        "npm ci",
        "for e in engine-kit trainer-yolo trainer-difusao trainer-clip; do (cd engines/$e && uv sync --extra test); done",
        "npx --no-install lefthook install"
      ],
      "test": [
        "set -e",
        "cargo test --workspace",
        "(cd apps/web && bun test)",
        "rc=0; for e in engine-kit trainer-yolo trainer-difusao trainer-clip; do (cd engines/$e && uv run --extra test pytest) || rc=1; done; exit $rc"
      ],
      "lint": [
        "set -e",
        "cargo fmt --all --check",
        "cargo clippy --workspace --all-targets",
        "npm run lint --workspace=web"
      ],
      "fmt": [
        "set -e",
        "cargo fmt --all",
        "npm run format --workspace=web -- --write"
      ],
      "up": [
        "set -e",
        "docker-compose -f infra/compose.yaml up -d --wait db seaweedfs",
        "docker-compose -f infra/compose.yaml up --no-deps --exit-code-from s3-init s3-init"
      ],
      "down": [
        "docker-compose -f infra/compose.yaml stop db seaweedfs"
      ]
    }
  }
}
