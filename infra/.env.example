# ── Infra local (não commitado — .gitignore) ──────────────────────────
# Copie para .env e ajuste os valores do seu host.

# SeaweedFS: bind externo para acesso multi-dispositivo (page via IP LAN).
# Comente ou deixe 127.0.0.1 para loopback-only (R1 ADR-0003).
# SEAWEED_PUBLISH=0.0.0.0
# S3_PUBLIC_ENDPOINT_URL=http://<IP_LAN>:8333

# ── Postgres ──────────────────────────────────────────────────────────
# POSTGRES_PASSWORD=studio

# ── Principal ─────────────────────────────────────────────────────────
# STUDIO_PASSWORD=changeme
# STUDIO_MASTER_KEY=changeme

# ── Manager / Orchestrator (auth interna Bearer) ─────────────────────
# MANAGER_TOKEN=changeme          # compartilhado principal ↔ manager ↔ orquestrador
# MANAGER_PUBLISH=0.0.0.0         # necessário para nó remoto (TrueNAS/GPU) enviar heartbeats
# PRINCIPAL_PUBLISH=0.0.0.0  # default 127.0.0.1 (loopback)
# WEB_PUBLISH=0.0.0.0        # default 127.0.0.1 (loopback)
# ── S3 admin (principal) ─────────────────────────────────────────────
# S3_ENDPOINT_URL=http://seaweedfs:8333
# S3_BUCKET=heph-data
# S3_ACCESS_KEY=heph
# S3_SECRET_KEY=heph-local-dev

# ── S3 orquestrador (escopo mínimo: packages/* + artifacts/*) ────────
# F4.6 — identidade heph-orchestrator no seaweedfs-s3.json (D2 ADR-0007).
# S3_ORCH_ENDPOINT_URL=http://seaweedfs:8333
# S3_ORCH_BUCKET=heph-data
# S3_ORCH_ACCESS_KEY=heph-orch
# S3_ORCH_SECRET_KEY=heph-orch-local-dev

# ── Orchestrator (operações) ─────────────────────────────────────────
# ORCH_WORKDIR=/data
# EXEC_MODE=docker               # default (spike F4.0: 3/3 PASS). Opções: docker|subprocess

# ── Embedder ──────────────────────────────────────────────────────────
# EMBEDDING_BACKEND=mock          # mock | clip (GPU real, @gpu manual)
# EMBEDDING_MODEL=ViT-B-32
