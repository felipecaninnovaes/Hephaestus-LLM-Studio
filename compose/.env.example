# ==============================================================================
# Hephaestus LLM Studio — Variáveis de Ambiente do Compose Público
# ==============================================================================
# Copie este arquivo para .env no mesmo diretório do arquivo compose escolhido:
#   cp .env.example .env
#
# Para gerar chaves seguras automaticamente, você pode executar:
#   ../scripts/setup.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Imagens e Versões (GitHub Container Registry)
# ------------------------------------------------------------------------------
REGISTRY_PREFIX=ghcr.io/felipecaninnovaes/hephaestus
HEPH_TAG=latest

# Imagens executadas sob demanda pelo Orchestrator (Data Plane)
# Para CPU / Mock use :latest; para aceleração CUDA use :gpu
TRAINER_IMAGE=ghcr.io/felipecaninnovaes/hephaestus-trainer-yolo:latest
DIFFUSION_TRAINER_IMAGE=ghcr.io/felipecaninnovaes/hephaestus-trainer-difusao:latest

# ------------------------------------------------------------------------------
# 2. Segurança e Autenticação do Control Plane
# ------------------------------------------------------------------------------
# Senha de acesso ao Studio Web (obrigatório alterar)
STUDIO_PASSWORD=changeme

# Token compartilhado entre api-principal, manager e orchestrator (obrigatório alterar)
MANAGER_TOKEN=changeme

# Senha do banco de dados Postgres
POSTGRES_PASSWORD=studio

# Chaves S3 do SeaweedFS (devem bater com o compose/seaweedfs-s3.json)
S3_ACCESS_KEY=heph
S3_SECRET_KEY=heph-local-dev
S3_ORCH_ACCESS_KEY=heph-orch
S3_ORCH_SECRET_KEY=heph-orch-local-dev
S3_BUCKET=heph-data

# ------------------------------------------------------------------------------
# 3. Endereçamento de Rede e Acesso Externo
# ------------------------------------------------------------------------------
# URL pública do S3 para download direto de artefatos pelo navegador
# Se acessar de outra máquina na rede local, mude localhost para o IP do servidor (ex: http://192.168.1.100:8333)
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

# Se estiver usando o modelo `local-sem-node.yaml` (Control Plane para nós remotos),
# libere as portas na rede local alterando os binds abaixo para 0.0.0.0:
MANAGER_PUBLISH=127.0.0.1
SEAWEED_PUBLISH=127.0.0.1
ORCHESTRATOR_PUBLISH=127.0.0.1
DB_PUBLISH=127.0.0.1

# ------------------------------------------------------------------------------
# 4. Configuração de Nós / Workers GPU (NVIDIA)
# ------------------------------------------------------------------------------
# IDs das GPUs para alocar nos jobs (ex: 0 ou 0,1 ou all)
ORCH_GPU_DEVICES=all

# Modo de execução do Orchestrator (docker = via socket; subprocess = processo direto)
EXEC_MODE=docker

# Daemon de inferência rápida de difusão (1 = ativo, 0 = inativo)
DIFFUSION_DAEMON_ENABLED=1
DIFFUSION_DAEMON_PORT=8766
DIFFUSION_DAEMON_IDLE_TTL_S=600

# ------------------------------------------------------------------------------
# 5. Configurações Exclusivas para Nós Remotos (remote-node.yaml)
# ------------------------------------------------------------------------------
# Endereço do Control Plane (onde rodam o Manager e o S3)
CONTROL_PLANE_IP=192.168.1.100

# Endereço anunciado por este nó remoto (onde o Manager pode alcançá-lo)
NODE_IP=192.168.1.105

# Código de pareamento informado na UI do Studio ao conectar este nó
ORCH_PAIRING_CODE=heph_pairing_secret_code
