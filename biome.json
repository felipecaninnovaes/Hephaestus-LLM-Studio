{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/web/**/*",
      "!apps/web/.next/**/*",
      "!apps/web/node_modules/**/*",
      "!apps/web/*.tsbuildinfo"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "recommended": true
      }
    }
  },
  "assist": {
    "enabled": true
  },
  "formatter": {
    "enabled": true
  }
}
