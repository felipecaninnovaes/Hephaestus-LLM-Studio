{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "hephaestus",
  "agent": {
    "build": { "disable": true },
    "plan": { "model": "opencode-go/qwen3.8-flash" }
  },
  "mcp": {
    "graft": {
      "type": "local",
      "command": [
        "graft",
        "mcp"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--browser-url=http://127.0.0.1:9222"],
      "enabled": true
    }
  }
}
