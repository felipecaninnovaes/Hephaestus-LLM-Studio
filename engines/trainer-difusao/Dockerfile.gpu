# syntax=docker/dockerfile:1
# Engine trainer-difusao GPU: treino real de Difusão LoRA (FLUX.2 Klein 4B, SDXL, SD 1.5).
# Base: hephaestus/engine-base-gpu (PyTorch 2.6.0 + CUDA 12.4 + cuDNN 9 + libs apt + USER studio uid 1000).
ARG BASE_GPU_IMAGE=hephaestus/engine-base-gpu:latest
FROM ${BASE_GPU_IMAGE}

# Commit SHA fixo do master do diffusers no GitHub (git ls-remote https://github.com/huggingface/diffusers HEAD)
ARG DIFFUSERS_COMMIT_SHA=c2798cc7859f258c6cfc5b2460e82b6cac71f235

# Dependências canônicas do ecossistema Diffusers / PEFT / HuggingFace
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
      "diffusers @ https://github.com/huggingface/diffusers/archive/${DIFFUSERS_COMMIT_SHA}.tar.gz" \
      "transformers>=4.48.0" \
      "accelerate>=1.2.0" \
      "peft>=0.14.0" \
      "bitsandbytes>=0.45.0" \
      "torchao==0.16.0" \
      "prodigyopt" \
      "safetensors>=0.4.5" \
      "sentencepiece" \
      "protobuf" \
      "pyyaml>=6.0" \
      "pillow>=10.0"

WORKDIR /app

# Copia engine_kit e pacote trainer_difusao
COPY engines/engine-kit/src/engine_kit/ /app/engine_kit/
COPY engines/trainer-difusao/src/trainer_difusao/ /app/trainer_difusao/

# Modo de treino real habilitado no container GPU e cache persistente em /outputs/.cache
ENV ENGINE_MOCK=0 \
    HF_HOME=/outputs/.cache/huggingface \
    HF_HUB_CACHE=/outputs/.cache/huggingface/hub \
    TRANSFORMERS_CACHE=/outputs/.cache/huggingface/hub \
    DIFFUSERS_CACHE=/outputs/.cache/huggingface/hub \
    TORCH_HOME=/outputs/.cache/torch \
    PYTHONUNBUFFERED=1

RUN chown -R studio:studio /app
USER studio

ENTRYPOINT ["python", "-m", "trainer_difusao"]
CMD ["train", "--config", "/dev/null", "--output", "/dev/null"]
