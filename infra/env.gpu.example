# ── env.gpu — Sessão GPU no TrueNAS (ADR-0010) ───────────────────────
# Copie para env.gpu no TrueNAS (repo clonado em
# /mnt/DADOS/home/dockeruser/Hephaestus-LLM-Studio) e ajuste os valores.
#
# Referências:
#   ADR-0010 D1/D3/D4/D10 — topologia, S3 na LAN, GPU device, segredos
#   infra/README-gpu.md    — checklist operacional completo da sessão
#
# Uso: docker compose -p gpu -f infra/compose.gpu.yaml --env-file infra/env.gpu up -d

# ── Manager (auth interna Bearer) ────────────────────────────────────
# O mesmo MANAGER_TOKEN do .env do dev host (10.15.10.3).
MANAGER_URL=http://10.15.10.3:8081
MANAGER_TOKEN=troque-aqui

# ── S3 orquestrador (identidade heph-orchestrator — packages/* + artifacts/*)
# SeaweedFS publicado na LAN do dev host (D3 ADR-0010).
S3_ORCH_ACCESS_KEY=heph-orch
S3_ORCH_SECRET_KEY=heph-orch-local-dev
S3_ORCH_BUCKET=heph-data
S3_ORCH_ENDPOINT_URL=http://10.15.10.3:8333

# ── Orquestrador GPU (advertise + pareamento com o manager) ───────────
ORCH_ADVERTISE_URL=http://10.15.1.2:8082
ORCH_PAIRING_CODE=troque-aqui

# ── GPU ──────────────────────────────────────────────────────────────
# Índice nvidia-smi do dispositivo de treino (D4 ADR-0010).
# 0 = RTX 3060 12GB (default); 1 = GTX 1660 Super 6GB (fallback).
# Conferir VRAM livre com nvidia-smi antes de escolher (README-gpu §Pre-flight).
ORCH_GPU_DEVICES=0

# ── Orçamento de execução do trainer (wall-clock) ─────────────────────
# Cap de segundos por execução de job no executor docker do orquestrador
# (default 7200 = 2h). Treinos longos (ex.: FLUX 1280px com ~1k imagens
# numa 3060 ≈ 34h) precisam de valor maior — 172800 = 48h.
# TRAINER_TIMEOUT_SECS=172800

# ── Hugging Face & Modelos de Difusão ──────────────────────────────────
# Token de leitura do Hugging Face Hub (obrigatório para modelos restritos/gated)
# Crie em: https://huggingface.co/settings/tokens
HF_TOKEN=

# Identificador do modelo FLUX no Hugging Face (ou caminho local/cache)
# Padrão: black-forest-labs/FLUX.2-klein-base-4B (modelo base oficial não-destilado para treino de LoRA)
# FLUX_MODEL_ID=black-forest-labs/FLUX.2-klein-base-4B
# FLUX_DISTILLED_MODEL_ID=black-forest-labs/FLUX.2-klein-4B

# ── Daemon de difusão residente (ADR-0023 D1) ────────────────────────
# Mantém o pipeline em VRAM entre gerações (evita reload do modelo por imagem).
# 1 = ligado; 0 = one-shot legado (container novo a cada geração).
DIFFUSION_DAEMON_ENABLED=1
# Duração do idle TTL em segundos antes de descarregar os pesos (default 600).
DIFFUSION_DAEMON_IDLE_TTL_S=600
# Tag da imagem construída NO NÓ (profile build do compose.gpu.yaml gera `:gpu`).
# O launcher do daemon NÃO herda a imagem do dispatch — sem isto cai em `:local`.
DIFFUSION_TRAINER_IMAGE=hephaestus/trainer-difusao:gpu

# ── Otimizações de VRAM no Treino (ADR-0021) ───────────────────────────
# Descarrega encoders de texto para CPU após pré-computar o cache de embeddings (libera ~2-8GB VRAM).
# 1 = habilitado; 0 = desabilitado (padrão conservador).
ENABLE_TEXT_ENCODER_UNLOAD=0

